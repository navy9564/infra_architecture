# cp hosts.ini.example hosts.ini
# 최소 구성: LB 2 + Control Plane 3 + Worker 3 (Rocky/RHEL 9 또는 Ubuntu 22.04/24.04)

[lb]
lb01 ansible_host=192.168.10.11 keepalived_priority=150
lb02 ansible_host=192.168.10.12 keepalived_priority=100

[control_plane]
cp01 ansible_host=192.168.10.21
cp02 ansible_host=192.168.10.22
cp03 ansible_host=192.168.10.23

[workers]
wk01 ansible_host=192.168.10.31
wk02 ansible_host=192.168.10.32
wk03 ansible_host=192.168.10.33

[k8s:children]
control_plane
workers

[all:vars]
ansible_user=infra
ansible_become=true
