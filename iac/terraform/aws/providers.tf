# -----------------------------------------------------------------------------
# providers.tf
#   EKS 클러스터 생성 직후 helm/kubernetes provider 가 같은 apply 안에서
#   클러스터에 접근할 수 있도록 exec(aws eks get-token) 방식을 사용한다.
# -----------------------------------------------------------------------------
provider "aws" {
  region = var.region

  default_tags {
    tags = local.tags
  }
}

provider "kubernetes" {
  host                   = module.eks.cluster_endpoint
  cluster_ca_certificate = base64decode(module.eks.cluster_certificate_authority_data)

  exec {
    api_version = "client.authentication.k8s.io/v1beta1"
    command     = "aws"
    args        = ["eks", "get-token", "--cluster-name", module.eks.cluster_name, "--region", var.region]
  }
}

# helm provider 3.x 는 kubernetes 설정을 "객체(=)" 문법으로 받는다.
provider "helm" {
  kubernetes = {
    host                   = module.eks.cluster_endpoint
    cluster_ca_certificate = base64decode(module.eks.cluster_certificate_authority_data)

    exec = {
      api_version = "client.authentication.k8s.io/v1beta1"
      command     = "aws"
      args        = ["eks", "get-token", "--cluster-name", module.eks.cluster_name, "--region", var.region]
    }
  }
}
